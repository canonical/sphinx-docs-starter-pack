#!/usr/bin/env bash
# docs/sp — Sphinx Stack documentation helper
# Replaces docs/Makefile with no make(1) dependency.

set -euo pipefail
trap 'echo "Error on line $LINENO" >&2' ERR

# ─── Anchor to script directory ───────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# ─── User-overridable settings (set in environment to customise) ──────────────
SPHINX_HOST="${SPHINX_HOST:-127.0.0.1}"
SPHINX_PORT="${SPHINX_PORT:-8000}"
SPHINX_OPTS="${SPHINX_OPTS:--c . -d _dev/.doctrees -j auto}"
SPHINX_BUILD="${SPHINX_BUILD:-.venv/bin/sphinx-build}"
PIPOPTS="${PIPOPTS:-}"

# ─── Internal constants (not intended to be overridden) ───────────────────────
DEV_DIR="_dev"
DOCS_VENVDIR=".venv"
DOCS_SOURCEDIR="."
DOCS_BUILDDIR="_build"
SPHINX_AUTOBUILD_OPTS="-D llms_txt_enabled=0"
DOCS_VOCAB="${DEV_DIR}/styles/config/vocabularies/Canonical"
VALE_CONFIG="${DEV_DIR}/vale.ini"
PA11Y_BIN="${DEV_DIR}/node_modules/pa11y/bin/pa11y.js"
PA11Y_CONFIG="${DEV_DIR}/pa11y.json"
DOCS_PDFPACKAGES=(
    latexmk fonts-freefont-otf texlive-latex-recommended
    texlive-latex-extra texlive-fonts-recommended texlive-font-utils
    texlive-lang-cjk texlive-xetex plantuml xindy tex-gyre dvipng
)
VERBOSE=0

# ─── Internal helpers ─────────────────────────────────────────────────────────

_run() {
    if [ "$VERBOSE" -eq 1 ]; then
        echo "+" "$@" >&2
    fi
    "$@"
}

_deprecated() {
    echo "Warning: './sp ${1}' is deprecated, use './sp ${2}' instead." >&2
}

_ensure_venv() {
    if [ ! -d "$DOCS_VENVDIR" ]; then
        echo "... setting up virtualenv"
        python3 -m venv "$DOCS_VENVDIR" \
            || { echo "You must install python3-venv before you can build the documentation."; exit 1; }
        # shellcheck disable=SC2086
        "$DOCS_VENVDIR/bin/pip" install $PIPOPTS --require-virtualenv \
            --upgrade -r requirements.txt \
            --log "$DOCS_VENVDIR/pip_install.log"
        [ -f "$DOCS_VENVDIR/pip_list.txt" ] \
            && mv "$DOCS_VENVDIR/pip_list.txt" "$DOCS_VENVDIR/pip_list.txt.bak"
        "$DOCS_VENVDIR/bin/pip" list --local --format=freeze \
            > "$DOCS_VENVDIR/pip_list.txt"
    fi
}

_get_vale_dir() {
    # Replaces: $(DOCS_VENVDIR)/lib/python*/site-packages/vale
    find "${DOCS_VENVDIR}/lib" -maxdepth 3 -name "vale" -type d 2>/dev/null \
        | head -1
}

_get_check_path() {
    # Replaces: $(filter-out $(DOCS_VENVDIR) $(DOCS_BUILDDIR) $(DEV_DIR),$(wildcard *))
    local result=() venvdir_base builddir_base devdir_base
    venvdir_base="$(basename "$DOCS_VENVDIR")"
    builddir_base="$(basename "$DOCS_BUILDDIR")"
    devdir_base="$(basename "$DEV_DIR")"
    for item in *; do
        [[ "$item" == "$venvdir_base" ]] && continue
        [[ "$item" == "$builddir_base" ]] && continue
        [[ "$item" == "$devdir_base" ]]  && continue
        result+=("$item")
    done
    echo "${result[*]}"
}

_vale_setup() {
    _ensure_venv
    if [ ! -f "$VALE_CONFIG" ]; then
        "$DOCS_VENVDIR/bin/python3" "$DEV_DIR/get_vale_conf.py"
    fi
    echo '.Name=="Canonical.400-Enforce-inclusive-terms"' \
        > "$DEV_DIR/styles/woke.filter"
    echo '.Level=="error" and .Name!="Canonical.500-Repeated-words" and .Name!="Canonical.000-US-spellcheck"' \
        > "$DEV_DIR/styles/error.filter"
    echo '.Name=="Canonical.000-US-spellcheck"' \
        > "$DEV_DIR/styles/spelling.filter"
    local vale_dir
    vale_dir="$(_get_vale_dir)"
    if [ -n "$vale_dir" ]; then
        find "$vale_dir/vale_bin" -size 195c \
            -exec "$DOCS_VENVDIR/bin/vale" --version \;
    fi
}

_pa11y_setup() {
    if [ ! -f "$PA11Y_BIN" ]; then
        echo "Installing \"pa11y\" from npm..."
        echo
        mkdir -p "$DEV_DIR/node_modules/"
        _run npm install --prefix "$DEV_DIR" pa11y
    fi
}

_pymarkdownlnt_setup() {
    _ensure_venv
    local pymarkdown_dir
    pymarkdown_dir="$(find "$DOCS_VENVDIR/lib" -maxdepth 3 \
        -name "pymarkdown" -type d 2>/dev/null | head -1)"
    if [ -z "$pymarkdown_dir" ]; then
        "$DOCS_VENVDIR/bin/pip" install pymarkdownlnt==0.9.35
    fi
}

_restore_vocab() {
    if [ -f "$DOCS_VOCAB/accept_backup.txt" ]; then
        cat "$DOCS_VOCAB/accept_backup.txt" > "$DOCS_VOCAB/accept.txt"
        rm "$DOCS_VOCAB/accept_backup.txt"
    fi
}

_vale_run() {
    local filter="$1"
    local check_path="$2"
    cp "$DOCS_VOCAB/accept.txt" "$DOCS_VOCAB/accept_backup.txt"
    trap '_restore_vocab' EXIT
    cat "$DOCS_SOURCEDIR/.custom_wordlist.txt" >> "$DOCS_VOCAB/accept.txt"
    # Word-split check_path intentionally: may contain multiple space-separated paths
    # shellcheck disable=SC2086
    _run "$DOCS_VENVDIR/bin/vale" \
        --config="$VALE_CONFIG" \
        --filter="$filter" \
        --glob='*.{md,rst}' \
        $check_path
    _restore_vocab
    trap - EXIT
}

# ─── Build and check internals (not exposed as commands) ─────────────────────

_clean_doc() {
    git clean -fx "$DOCS_BUILDDIR"
    rm -rf "$DEV_DIR/.doctrees"
}

_pdf_prep() {
    _ensure_venv
    for packageName in "${DOCS_PDFPACKAGES[@]}"; do
        if dpkg-query -W -f='${Status}' "$packageName" 2>/dev/null \
                | grep -c "ok installed" >/dev/null; then
            echo "Package $packageName is installed"
        else
            echo
            echo "PDF generation requires the installation of the following packages: ${DOCS_PDFPACKAGES[*]}"
            echo ""
            echo "Install them with:"
            echo "  sudo apt-get install --no-install-recommends -y ${DOCS_PDFPACKAGES[*]}"
            echo ""
            echo "Please be aware these packages will be installed to your system."
            exit 1
        fi
    done
}

_build_watch() {
    _ensure_venv
    # shellcheck disable=SC2086
    _run "$DOCS_VENVDIR/bin/sphinx-autobuild" \
        -b dirhtml \
        --host "$SPHINX_HOST" \
        --port "$SPHINX_PORT" \
        "$DOCS_SOURCEDIR" "$DOCS_BUILDDIR" \
        $SPHINX_OPTS $SPHINX_AUTOBUILD_OPTS
}

_build_html() {
    _ensure_venv
    # shellcheck disable=SC2086
    _run "$SPHINX_BUILD" \
        --fail-on-warning --keep-going \
        -b dirhtml \
        "$DOCS_SOURCEDIR" "$DOCS_BUILDDIR" \
        -w "$DEV_DIR/warnings.txt" \
        $SPHINX_OPTS
}

_build_pdf() {
    _pdf_prep
    # shellcheck disable=SC2086
    _run "$SPHINX_BUILD" -M latexpdf "$DOCS_SOURCEDIR" "$DOCS_BUILDDIR" $SPHINX_OPTS
    rm -f "$DOCS_BUILDDIR/latex/front-page-light.pdf"
    rm -f "$DOCS_BUILDDIR/latex/normal-page-footer.pdf"
    find "$DOCS_BUILDDIR/latex" -name '*.pdf' -exec mv -t "$DOCS_BUILDDIR" {} +
    rm -r "$DOCS_BUILDDIR/latex"
    echo
    echo "Output can be found in ./$DOCS_BUILDDIR"
    echo
}

_check_style() {
    _vale_setup
    local check_path
    check_path="${CHECK_PATH:-$(_get_check_path)}"
    echo "Running Vale style check against $check_path. To change target set CHECK_PATH= with sp command"
    _vale_run "$DEV_DIR/styles/error.filter" "$check_path"
    echo "Running Vale inclusive-language check against $check_path."
    _vale_run "$DEV_DIR/styles/woke.filter" "$check_path"
    echo "Running Vale spelling check against $check_path."
    _vale_run "$DEV_DIR/styles/spelling.filter" "$check_path"
}

_check_markdown() {
    _pymarkdownlnt_setup
    local status=0
    # shellcheck disable=SC2086
    _run "$DOCS_VENVDIR/bin/pymarkdownlnt" \
        --config "$DEV_DIR/.pymarkdown.json" \
        --return-code-scheme explicit \
        scan \
        --recurse \
        --exclude="$DEV_DIR/**" \
        --exclude="$DOCS_VENVDIR/**" \
        "$DOCS_SOURCEDIR" \
        || status=$?
    if [ "$status" -eq 1 ]; then
        echo "No Markdown files selected for linting"
        return 0
    fi
    echo "pymarkdownlnt exited with code $status"
    return "$status"
}

_check_links() {
    _ensure_venv
    # shellcheck disable=SC2086
    _run "$SPHINX_BUILD" -b linkcheck -q \
        "$DOCS_SOURCEDIR" "$DOCS_BUILDDIR" \
        $SPHINX_OPTS \
        || {
            grep --color -F "[broken]" "$DOCS_BUILDDIR/output.txt" || true
            exit 1
        }
}

_check_accessibility() {
    _pa11y_setup
    _build_html
    if [ "$VERBOSE" -eq 1 ]; then
        echo "+ find \"$DOCS_BUILDDIR\" -name '*.html' -print0 | xargs -n 1 -0 \"$PA11Y_BIN\" --config \"$PA11Y_CONFIG\"" >&2
    fi
    find "$DOCS_BUILDDIR" -name '*.html' -print0 \
        | xargs -n 1 -0 "$PA11Y_BIN" --config "$PA11Y_CONFIG"
}

# ─── Commands ─────────────────────────────────────────────────────────────────

cmd_build() {
    local subcmd="" clean=0
    for arg in "$@"; do
        case "$arg" in
            --clean)   clean=1 ;;
            --verbose) VERBOSE=1 ;;
            html|pdf)  subcmd="$arg" ;;
            "")        ;;
            *) echo "Unknown build option: $arg" >&2; exit 1 ;;
        esac
    done
    [ "$clean" -eq 1 ] && _clean_doc
    case "$subcmd" in
        html) _build_html ;;
        pdf)  _build_pdf ;;
        "")   _build_watch ;;
    esac
}

cmd_check() {
    local subcmd=""
    for arg in "$@"; do
        case "$arg" in
            --verbose)                           VERBOSE=1 ;;
            style|markdown|links|accessibility)  subcmd="$arg" ;;
            "")                                  ;;
            *) echo "Unknown check option: $arg" >&2; exit 1 ;;
        esac
    done
    case "$subcmd" in
        style)         _check_style ;;
        markdown)      _check_markdown ;;
        links)         _check_links ;;
        accessibility) _check_accessibility ;;
        "")
            _check_style
            _check_markdown
            _check_links
            _check_accessibility
            ;;
    esac
}

cmd_clean() {
    _clean_doc
}

cmd_setup() {
    local refresh=0
    for arg in "$@"; do
        case "$arg" in
            --refresh) refresh=1 ;;
            *) echo "Unknown setup option: $arg" >&2; exit 1 ;;
        esac
    done
    [ "$refresh" -eq 1 ] && cmd_remove
    _ensure_venv
}

cmd_remove() {
    _clean_doc
    if [ -e "$DOCS_VENVDIR" ]; then
        if ! [ -d "$DOCS_VENVDIR" ] || [[ "$DOCS_VENVDIR" == /* ]]; then
            echo "Refusing to remove '$DOCS_VENVDIR': not a relative directory path." >&2
            exit 1
        fi
        rm -rf "$DOCS_VENVDIR"
    fi
    rm -rf "$DEV_DIR/node_modules/"
    rm -rf "$DEV_DIR/styles"
    rm -rf "$VALE_CONFIG"
}

cmd_update() {
    _ensure_venv
    _run "$DOCS_VENVDIR/bin/python3" "$DEV_DIR/update_sp.py"
}

usage() {
    echo
    echo "-------------------------------------------------------------"
    echo "* watch, build and serve the documentation:  ./sp build"
    echo "* build HTML to disk:                        ./sp build html"
    echo "* build a PDF:                               ./sp build pdf"
    echo "* run all checks:                            ./sp check"
    echo "* check spelling and style:                  ./sp check style"
    echo "* check Markdown formatting:                 ./sp check markdown"
    echo "* check hyperlinks:                          ./sp check links"
    echo "* check web accessibility:                   ./sp check accessibility"
    echo "* clean built doc files:                     ./sp clean"
    echo "* set up the docs environment:               ./sp setup"
    echo "* remove the docs environment:               ./sp remove"
    echo "* update the docs base:                      ./sp update"
    echo ""
    echo "Flags:  --clean   (build)        remove cached files before building"
    echo "        --verbose (build/check)  print each command as it runs"
    echo "        --refresh (setup)        remove old environment first"
    echo "        CHECK_PATH=<dir>         scope style checks to a path"
    echo "-------------------------------------------------------------"
    echo
}

# ─── Routing ──────────────────────────────────────────────────────────────────

main() {
    case "${1:-help}" in
        # Primary commands (and silent aliases)
        build|run|auto|serve|server)  cmd_build "${@:2}" ;;
        check|lint)                   cmd_check "${@:2}" ;;
        clean)                        cmd_clean ;;
        setup|install)                cmd_setup "${@:2}" ;;
        remove)                       cmd_remove ;;
        update)                       cmd_update ;;

        # Deprecated aliases — warn then route to new command
        html)       _deprecated "html"        "build html";          cmd_build html ;;
        pdf)        _deprecated "pdf"         "build pdf";           cmd_build pdf ;;
        vale)       _deprecated "vale"        "check style";         cmd_check style ;;
        woke)       _deprecated "woke"        "check style";         cmd_check style ;;
        spelling)   _deprecated "spelling"    "check style";         cmd_check style ;;
        spellcheck) _deprecated "spellcheck"  "check style";         cmd_check style ;;
        linkcheck)  _deprecated "linkcheck"   "check links";         cmd_check links ;;
        lint-md)    _deprecated "lint-md"     "check markdown";      cmd_check markdown ;;
        pa11y)      _deprecated "pa11y"       "check accessibility"; cmd_check accessibility ;;
        clean-doc)  _deprecated "clean-doc"   "clean";               cmd_clean ;;

        help|--help|-h)  usage ;;
        *)
            echo "Unknown command: ${1}" >&2
            echo "Run './sp help' to see available commands." >&2
            exit 1
            ;;
    esac
}

main "$@"
