#!/bin/bash
# docs/sp — Sphinx Stack documentation helper
# Replaces docs/Makefile with no make(1) dependency.

set -euo pipefail
trap 'echo "Error in ${BASH_SOURCE[0]} on line $LINENO: $BASH_COMMAND" >&2' ERR

# ─── Anchor to script directory ───────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR
cd "${SCRIPT_DIR}"

# ─── User-overridable settings (set in environment to customise) ──────────────
SPHINX_HOST="${SPHINX_HOST:-127.0.0.1}"
SPHINX_PORT="${SPHINX_PORT:-8000}"
SPHINX_OPTS="${SPHINX_OPTS:--c . -d _dev/.doctrees -j auto}"
SPHINX_BUILD="${SPHINX_BUILD:-.venv/bin/sphinx-build}"
PIPOPTS="${PIPOPTS:-}"

# ─── Internal constants (not intended to be overridden) ───────────────────────
readonly DEV_DIR="_dev"
readonly DOCS_VENVDIR=".venv"
readonly DOCS_SOURCEDIR="."
readonly DOCS_BUILDDIR="_build"
readonly SPHINX_AUTOBUILD_OPTS="-D llms_txt_enabled=0"
readonly DOCS_VOCAB="${DEV_DIR}/styles/config/vocabularies/Canonical"
readonly VALE_CONFIG="${DEV_DIR}/vale.ini"
readonly DOCS_PDFPACKAGES=(
  latexmk fonts-freefont-otf texlive-latex-recommended
  texlive-latex-extra texlive-fonts-recommended texlive-font-utils
  texlive-lang-cjk texlive-xetex plantuml xindy tex-gyre dvipng
)
VERBOSE=0

# ─── Load modules ─────────────────────────────────────────────────────────────

source "${SCRIPT_DIR}/_lib/helpers.sh"
source "${SCRIPT_DIR}/_lib/build.sh"
source "${SCRIPT_DIR}/_lib/check.sh"
source "${SCRIPT_DIR}/_lib/clean.sh"
source "${SCRIPT_DIR}/_lib/infra.sh"

# ─── Routing ──────────────────────────────────────────────────────────────────

usage() {
  echo "Run './sp help <command>' to view a command's usage."
  echo
  echo "Main commands:"
  echo "             build  Render the docs"
  echo "             check  Check for problems in the documentation"
  echo "             clean  Remove built docs and temporary files"
  echo
  echo "Sphinx Stack infra commands:"
  echo "             update  Update the docs base"

  echo
  echo "Global options:"
  echo "             --verbose  Show more commands in the terminal"
  echo "             --help  Show this help"
}

main() {
  local args=()
  for arg in "$@"; do
    case "${arg}" in
      --verbose) VERBOSE=1 ;;
      *)         args+=("${arg}") ;;
    esac
  done

  case "${args[0]:-help}" in
    build)   cmd_build "${args[@]:1}" ;;
    check)   cmd_check "${args[@]:1}" ;;
    clean)   cmd_clean "${args[@]:1}" ;;
    update)  cmd_update "${args[@]:1}" ;;

    # Makefile aliases — deprecated, use sp commands instead
    run)        _warn_alias "run"        "build";          cmd_build "${args[@]:1}" ;;
    serve)      _warn_alias "serve"      "build";          cmd_build "${args[@]:1}" ;;
    html)       _warn_alias "html"       "build html";     cmd_build html "${args[@]:1}" ;;
    pdf)        _warn_alias "pdf"        "build pdf";      cmd_build pdf "${args[@]:1}" ;;
    clean-doc)  _warn_alias "clean-doc"  "clean";          cmd_clean "${args[@]:1}" ;;
    install)    _warn_alias "install"    "build";          cmd_build "${args[@]:1}" ;;
    linkcheck)  _warn_alias "linkcheck"  "check links";    cmd_check links "${args[@]:1}" ;;
    spelling)   _warn_alias "spelling"   "check style";    cmd_check style "${args[@]:1}" ;;
    spellcheck) _warn_alias "spellcheck" "check style";    cmd_check style "${args[@]:1}" ;;
    vale)       _warn_alias "vale"       "check style";    cmd_check style "${args[@]:1}" ;;
    lint-md)    _warn_alias "lint-md"    "check markdown"; cmd_check markdown "${args[@]:1}" ;;
    woke)       _err "Error: 'woke' has been removed from sp." ;;
    pa11y)      _err "Error: 'pa11y' has been removed from sp." ;;

    help|--help|-h)  usage ;;
    *)
      _err "Unknown command: ${args[0]}. Run './sp help' to see available commands."
      ;;
  esac
}

main "$@"
